# Normalize line endings: text files are stored with LF in the repo and checked out with LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings, never diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.heic binary
*.heif binary
*.jxl  binary
*.tif  binary
*.tiff binary
*.bmp  binary
*.ico  binary
*.tga  binary
*.qoi  binary
*.dds  binary
*.exr  binary
*.hdr  binary
*.mp4  binary
*.mkv  binary
*.webm binary
*.mov  binary
*.avi  binary
*.dll  binary
*.ttf  binary
*.otf  binary
